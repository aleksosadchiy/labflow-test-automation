{
  "extraKnownMarketplaces": {
    "awos-marketplace": {
      "source": {
        "source": "github",
        "repo": "provectus/awos"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash(javap *)",
      "Bash(gh run watch *)",
      "Bash(gh cache list *)",
      "Bash(gh secret list *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_sensitive_files.py\""
          }
        ]
      }
    ]
  }
}
