<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        This module intentionally uses spring-boot-starter-parent directly and is NOT a child
        of any multi-module reactor. Per architecture.md, mock-lab-app must stay structurally
        separate from the future test-automation Maven reactor (common, api-client, api-tests,
        ui-tests, test-data) so it plugs in later as an unrelated sibling, never a parent/child.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.mocklab</groupId>
    <artifactId>mock-lab-app</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>mock-lab-app</name>
    <description>Mock Lab Application - system under test for the LabFlow Test Automation project</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Stable artifact name so CI and docs can rely on target/mock-lab-app.jar (no version suffix). -->
        <finalName>mock-lab-app</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!--
                Test coverage (JaCoCo): prepare-agent adds a Java agent to the test JVM (through the
                argLine property Surefire reads) that records which lines the tests execute; report
                turns that record into target/site/jacoco/ (index.html to read, jacoco.xml for tools)
                right after the tests. No minimum is enforced on purpose: the number is information,
                not a target.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.16</version>
                <executions>
                    <execution>
                        <id>coverage-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>coverage-report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
                Formatting gate (Spotless), the same rules as the test-automation reactor's root
                pom.xml (this app is a separate build, so it carries its own copy). Deliberately light rules that match how the code is
                already written, so there is no mass reformat: no unused imports, no trailing
                spaces, spaces instead of tabs, a newline at the end of every file.
                Not bound to a build phase: `./mvnw spotless:check` fails on a violation (CI's Build
                job runs it) and `./mvnw spotless:apply` fixes the files.
            -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <java>
                        <removeUnusedImports/>
                        <trimTrailingWhitespace/>
                        <indent>
                            <spaces>true</spaces>
                            <spacesPerTab>4</spacesPerTab>
                        </indent>
                        <endWithNewline/>
                    </java>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
