<?xml version="1.0" encoding="UTF-8"?>
<!--
  Run log for the checks.
  - Console: INFO and above, one short line per request. The check name comes from the MDC key
    "check" (RunLog.CHECK_NAME_KEY, set by the scenario hooks), so every line says which check it
    belongs to.
  - File target/logs/api-tests.log: everything at DEBUG from our own loggers (lab.http), rewritten
    on every run (append=false) and removed by "clean". The path is relative because Surefire runs
    with the module as its working directory.
  - Allure report: the "lab.http" logger also feeds each INFO request line of a running check to
    AllureStepAppender, which turns it into a step of that check (the root loggers do not).
  Only the "lab.http" logger is lowered to DEBUG (masked bodies, when -DlogBodies=true). The root
  stays at INFO so RestAssured, Apache HttpClient and Playwright cannot flood the file with
  their own DEBUG output.
-->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %X{check} %msg%n</pattern>
        </encoder>
    </appender>
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>target/logs/api-tests.log</file>
        <append>false</append>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %X{check} %msg%n</pattern>
        </encoder>
    </appender>
    <!-- Every request line (INFO) of a running check also becomes a step in its Allure report. -->
    <appender name="ALLURE" class="com.labflow.tests.framework.log.AllureStepAppender"/>
    <logger name="lab.http" level="DEBUG">
        <appender-ref ref="ALLURE"/>
    </logger>
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
