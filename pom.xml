<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Root parent of the test-automation reactor. mock-lab-app is deliberately NOT a module here:
        it is the system under test and keeps its own build and wrapper, so a top-level command can
        never build, start or stop the lab. Versions are declared once, here; children carry none.
    -->
    <groupId>com.labflow</groupId>
    <artifactId>lab-test-automation</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>lab-test-automation</name>
    <description>Test automation framework for the mock lab: shared model, API client and workflow checks</description>

    <modules>
        <module>common</module>
        <module>api-client</module>
        <module>ui-tests</module>
        <module>api-tests</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>

        <junit.version>5.14.4</junit.version>
        <rest-assured.version>5.5.7</rest-assured.version>
        <jackson.version>2.19.2</jackson.version>
        <assertj.version>3.27.7</assertj.version>
        <playwright.version>1.63.0</playwright.version>

        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
        <exec-maven-plugin.version>3.6.4</exec-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.rest-assured</groupId>
                <artifactId>rest-assured</artifactId>
                <version>${rest-assured.version}</version>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
            </dependency>
            <dependency>
                <groupId>com.microsoft.playwright</groupId>
                <artifactId>playwright</artifactId>
                <version>${playwright.version}</version>
            </dependency>

            <!-- Sibling modules -->
            <dependency>
                <groupId>com.labflow</groupId>
                <artifactId>common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.labflow</groupId>
                <artifactId>api-client</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.labflow</groupId>
                <artifactId>api-tests</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Versions only. Surefire stays at its defaults on purpose (see technical-considerations 2.2). -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!--
                One-time browser install: `./mvnw -N exec:java` runs Playwright's own CLI
                (`install chromium`), so no Node toolchain is needed. It lives on the root only
                (inherited=false, run with -N) and brings Playwright in as a plugin dependency, so it
                needs no reactor build and no sibling SNAPSHOTs in ~/.m2.
                The default arguments below are replaced by -Dexec.args, which reuses the same CLI,
                e.g. `-Dexec.args="show-trace <path-to-trace.zip>"`.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec-maven-plugin.version}</version>
                <inherited>false</inherited>
                <dependencies>
                    <dependency>
                        <groupId>com.microsoft.playwright</groupId>
                        <artifactId>playwright</artifactId>
                        <version>${playwright.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <mainClass>com.microsoft.playwright.CLI</mainClass>
                    <includeProjectDependencies>false</includeProjectDependencies>
                    <includePluginDependencies>true</includePluginDependencies>
                    <arguments>
                        <argument>install</argument>
                        <argument>chromium</argument>
                    </arguments>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
