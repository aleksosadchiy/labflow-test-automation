<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Root parent of the test-automation reactor. mock-lab-app is deliberately NOT a module here:
        it is the system under test and keeps its own build and wrapper, so a top-level command can
        never build, start or stop the lab. Versions are declared once, here; children carry none.
    -->
    <groupId>com.labflow</groupId>
    <artifactId>lab-test-automation</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>lab-test-automation</name>
    <description>Test automation framework for the mock lab: shared model, API client and workflow checks</description>

    <modules>
        <module>common</module>
        <module>test-data</module>
        <module>api-client</module>
        <module>ui-tests</module>
        <module>api-tests</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>

        <junit.version>5.14.4</junit.version>
        <rest-assured.version>5.5.7</rest-assured.version>
        <jackson.version>2.19.2</jackson.version>
        <assertj.version>3.27.7</assertj.version>
        <playwright.version>1.63.0</playwright.version>
        <slf4j.version>2.0.20</slf4j.version>
        <logback.version>1.5.38</logback.version>
        <!-- The 2.x line on purpose: Allure 3.0 is built against JUnit 6, this project is on JUnit 5. -->
        <allure.version>2.35.5</allure.version>

        <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
        <exec-maven-plugin.version>3.6.4</exec-maven-plugin.version>
        <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
        <spotless-maven-plugin.version>3.10.4</spotless-maven-plugin.version>
        <allure-maven.version>3.1.0</allure-maven.version>
        <!-- The Allure Report tool that allure-maven downloads to build the HTML report. -->
        <allure-report.version>2.46.1</allure-report.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-bom</artifactId>
                <version>${allure.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.rest-assured</groupId>
                <artifactId>rest-assured</artifactId>
                <version>${rest-assured.version}</version>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
            </dependency>
            <dependency>
                <groupId>com.microsoft.playwright</groupId>
                <artifactId>playwright</artifactId>
                <version>${playwright.version}</version>
            </dependency>
            <!--
                Run log: SLF4J is the logging API the framework code writes to; Logback is the
                implementation, added at test scope only where a run actually prints the log.
            -->
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-classic</artifactId>
                <version>${logback.version}</version>
            </dependency>

            <!-- Sibling modules -->
            <dependency>
                <groupId>com.labflow</groupId>
                <artifactId>common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.labflow</groupId>
                <artifactId>test-data</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.labflow</groupId>
                <artifactId>api-client</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.labflow</groupId>
                <artifactId>api-tests</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!--
                    Versions, plus one Surefire change: readable test names. Everything else in
                    Surefire stays at its defaults on purpose (see spec 003 technical-considerations 2.2).
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>${maven-clean-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <!--
                        Surefire's JUnit 5 reporters, so a check shows up under its @DisplayName and
                        its parameterized row name (e.g. "A blank username is refused") instead of its
                        Java method name: in the "Running ..." / "Tests run ..." console lines, the .txt
                        reports and the TEST-*.xml reports, for every module (spec 004 FS 2.3).
                        Report FILE names and the XML testcase classname stay the Java class name, so
                        tools that map results back to source files keep working.
                    -->
                    <configuration>
                        <statelessTestsetReporter implementation="org.apache.maven.plugin.surefire.extensions.junit5.JUnit5Xml30StatelessReporter">
                            <usePhrasedFileName>false</usePhrasedFileName>
                            <usePhrasedTestSuiteClassName>true</usePhrasedTestSuiteClassName>
                            <usePhrasedTestCaseClassName>false</usePhrasedTestCaseClassName>
                            <usePhrasedTestCaseMethodName>true</usePhrasedTestCaseMethodName>
                        </statelessTestsetReporter>
                        <statelessTestsetInfoReporter implementation="org.apache.maven.plugin.surefire.extensions.junit5.JUnit5StatelessTestsetInfoReporter">
                            <usePhrasedFileName>false</usePhrasedFileName>
                            <usePhrasedClassNameInRunning>true</usePhrasedClassNameInRunning>
                            <usePhrasedClassNameInTestCaseSummary>true</usePhrasedClassNameInTestCaseSummary>
                        </statelessTestsetInfoReporter>
                    </configuration>
                </plugin>
                <!--
                    Allure Report: turns the result files the checks write into ONE shared
                    folder, target/allure-results at the repository root (see allure.properties
                    in api-tests and ui-tests), into one HTML page. Not bound to a build phase;
                    build the report after the tests with the script, not with the bare goal:
                        .github/scripts/report.sh
                    The script runs `./mvnw -N allure:report` with ALLURE_NO_ANALYTICS=true,
                    because the tool's Google Analytics (a tag in the page and an event sent on
                    every build) can only be switched off through the environment, which this
                    plugin has no setting for.
                    -N (non-recursive) = this root project only, so the plugin reads the root's
                    own target/ and writes target/site/allure-maven-plugin/index.html.
                    resultsDirectory is relative on purpose: the plugin resolves it against the
                    project's build directory (target/).
                    singleFile = one self-contained index.html that opens straight from disk or
                    from a downloaded CI artifact, with no web server. The tool itself is
                    downloaded from Maven Central on first use into .allure/ at the repository
                    root (gitignored): pinned by version, not checksum-verified, which is accepted
                    for a reporting tool that touches no secret.
                -->
                <plugin>
                    <groupId>io.qameta.allure</groupId>
                    <artifactId>allure-maven</artifactId>
                    <version>${allure-maven.version}</version>
                    <configuration>
                        <reportVersion>${allure-report.version}</reportVersion>
                        <resultsDirectory>allure-results</resultsDirectory>
                        <installDirectory>${maven.multiModuleProjectDirectory}/.allure</installDirectory>
                        <singleFile>true</singleFile>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!--
                Test coverage (JaCoCo): prepare-agent adds a Java agent to the test JVM (through the
                argLine property Surefire reads) that records which lines the tests execute; report
                turns that record into target/site/jacoco/ (index.html to read, jacoco.xml for tools)
                right after the tests. No minimum is enforced on purpose: the number is information,
                not a target. A module's report covers that module's own classes only.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>coverage-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>coverage-report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
                Formatting gate (Spotless). Deliberately light rules that match how the code is
                already written, so there is no mass reformat: no unused imports, no trailing
                spaces, spaces instead of tabs, a newline at the end of every file.
                Not bound to a build phase: `./mvnw spotless:check` fails on a violation (CI's Build
                job runs it) and `./mvnw spotless:apply` fixes the files.
            -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless-maven-plugin.version}</version>
                <configuration>
                    <java>
                        <removeUnusedImports/>
                        <trimTrailingWhitespace/>
                        <indent>
                            <spaces>true</spaces>
                            <spacesPerTab>4</spacesPerTab>
                        </indent>
                        <endWithNewline/>
                    </java>
                </configuration>
            </plugin>
            <!--
                A run starts with no Allure results and no built report. Both check modules write
                their result files into the root's target/allure-results, so this one execution, on
                the root project only (inherited=false), deletes two folders at `validate`, the FIRST
                phase of the default lifecycle (so even `./mvnw validate` starts empty):
                  - target/allure-results: a second run never mixes with the first, and a
                    single-family run leaves nothing from the other family;
                  - target/site/allure-maven-plugin (the built report): with no results the report
                    goal builds nothing but leaves an old index.html in place, so without this the
                    previous run's report could be mistaken for the new run's.
                The root is first in the reactor for every documented command (also
                `-pl api-tests -am`). excludeDefaultDirectories = do NOT delete target/ itself,
                only the filesets below. Consequence: any lifecycle command started from the root
                (even `validate`) removes both; `allure:report` is a direct goal with no
                lifecycle, so it does not.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <inherited>false</inherited>
                <executions>
                    <execution>
                        <id>empty-allure-results</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.directory}/allure-results</directory>
                                </fileset>
                                <fileset>
                                    <directory>${project.build.directory}/site/allure-maven-plugin</directory>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Declared on the root only: the report is built once, from the shared folder (see pluginManagement). -->
            <plugin>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-maven</artifactId>
                <inherited>false</inherited>
            </plugin>
            <!--
                One-time browser install: `./mvnw -N exec:java` runs Playwright's own CLI
                (`install chromium`), so no Node toolchain is needed. It lives on the root only
                (inherited=false, run with -N) and brings Playwright in as a plugin dependency, so it
                needs no reactor build and no sibling SNAPSHOTs in ~/.m2.
                The default arguments below are replaced by -Dexec.args, which reuses the same CLI,
                e.g. `-Dexec.args="show-trace <path-to-trace.zip>"`.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec-maven-plugin.version}</version>
                <inherited>false</inherited>
                <dependencies>
                    <dependency>
                        <groupId>com.microsoft.playwright</groupId>
                        <artifactId>playwright</artifactId>
                        <version>${playwright.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <mainClass>com.microsoft.playwright.CLI</mainClass>
                    <includeProjectDependencies>false</includeProjectDependencies>
                    <includePluginDependencies>true</includePluginDependencies>
                    <arguments>
                        <argument>install</argument>
                        <argument>chromium</argument>
                    </arguments>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
